# Supabase project URL (same project as the main FieldVision app)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Service role key. Server side only, never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe secret key (same as Supabase STRIPE_SECRET_KEY). Server side only.
STRIPE_SECRET_KEY=sk_live_...

# Shared password for the dashboard login gate
ANALYTICS_PASSWORD=choose-a-password

# Secret the Supabase triggers send in the x-notify-secret header to /api/notify
NOTIFY_SECRET=same-secret-as-in-the-analytics_notify_event-db-function

# APNs push credentials for the iOS app (from developer.apple.com > Keys)
APNS_TEAM_ID=your-apple-team-id
APNS_KEY_ID=your-apns-key-id
APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
APNS_TOPIC=ai.fieldvision.analytics
